# Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# File .env đã nằm trong .gitignore. KHÔNG commit .env, KHÔNG dán key vào chat/prompt.
 
# --- Postgres (dùng bởi docker-compose.yml) ---
POSTGRES_USER=english
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=english_companion
 
# --- Ứng dụng chạy trên máy (uvicorn ngoài Docker) ---
# Dùng 127.0.0.1, KHÔNG dùng localhost: trên Windows localhost thử IPv6 (::1) trước
# trong khi Postgres chỉ mở ở 127.0.0.1, nên kết nối bị treo.
DATABASE_URL=postgresql+psycopg://english:doi_mat_khau_nay@127.0.0.1:5432/english_companion
# Database dành riêng cho pytest, tránh xóa nhầm dữ liệu học thật.
TEST_DATABASE_URL=postgresql+psycopg://english:doi_mat_khau_nay@127.0.0.1:5432/english_companion_test
 
# --- AI ---
# fake   = không gọi API, không tốn tiền (mặc định cho dev và test)
# gemini = gọi Gemini API thật, cần GEMINI_API_KEY
AI_PROVIDER=fake
# Lấy key ở https://aistudio.google.com/apikey . KHÔNG dán key vào chat, prompt hay Git.
GEMINI_API_KEY=
# Model dùng được với key của bạn: xem https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash-lite
# Mức "suy nghĩ": minimal | low | medium | high (mỗi model hỗ trợ khác nhau).
# Token suy nghĩ bị tính vào AI_MAX_OUTPUT_TOKENS. Để trống = mặc định của model.
GEMINI_THINKING_LEVEL=minimal
AI_MAX_OUTPUT_TOKENS=800
# Thời gian chờ tối đa cho mỗi lần gọi AI (giây)
AI_TIMEOUT_SECONDS=30
# Số lần gọi AI tối đa mỗi ngày (tính cả lần gọi sửa JSON)
DAILY_AI_LIMIT=100